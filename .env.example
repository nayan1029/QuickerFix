# Copy to .env for local Docker Compose use. Replace all example credentials before deployment.
POSTGRES_PASSWORD=local-only-change-me
JWT_SECRET=VGhpc0lzRGV2ZWxvcG1lbnRPbmx5U2VjcmV0S2V5MzIx
DATA_ENCRYPTION_KEY=UXVpY2tGaXhEZXZLZXktMjAyNi1Mb2NhbC1Pbmx5ISE=

# Optional one-time administrator bootstrap. Leave blank to disable.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional Google OAuth client ID. Email/password registration works without it.
GOOGLE_CLIENT_ID=

# Optional local allowed web origins and HTTPS production host
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:3000
PUBLIC_DOMAIN=app.example.com
